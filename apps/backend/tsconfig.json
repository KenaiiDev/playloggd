{
  "references": [{ "path": "../../domain" }],
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "composite": true,
    "typeRoots": ["./src/types"],
    "paths": {
      "@/*": ["./src/*"],
      "@domain/*": ["../../domain/src/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "**/__mocks__/**", "**/*.test.ts"]
}
